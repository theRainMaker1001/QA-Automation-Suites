{
  "name": "automatedtesting",
  "version": "1.0.0",
  "private": true,
  "description": "Professional QA automation suite with TypeScript, linting, formatting, and CI integration.",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "main": "index.js",
  "type": "module",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "build:api": "tsc -p api/tsconfig.json",
    "test:api": "vitest run",
    "clean": "rimraf dist api/dist",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "lint": "eslint . --ext .ts --format stylish --cache",
    "fmt": "prettier --write .",
    "prepare": "husky install",
    "start": "tsx ./e2e/tests/index.ts",
    "dev": "tsx watch ./e2e/tests/index.ts",
    "tooling:summary": "tsx config/tooling-summary.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "qa",
    "automation",
    "testing",
    "typescript",
    "ci-cd",
    "playwright"
  ],
  "author": "Tom Cunningham",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "zod": "^4.1.13"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
