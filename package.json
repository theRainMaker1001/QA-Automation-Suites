{
  "name": "automatedtesting",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation suite with TypeScript, linting, formatting, and CI integration.",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "main": "index.js",
  "type": "module",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "build:api": "tsc -p api/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts && tsx api/src/helpers/generate-unit-summary.ts",
    "test:api": "vitest run --config vitest.integration.config.ts",
    "test:api:smoke": "vitest run --config vitest.integration.config.ts --testNamePattern @smoke",
    "test:api:critical": "vitest run --config vitest.integration.config.ts --testNamePattern @critical",
    "test:all": "npm run test:unit && npm run test:api",
    "test": "npm run test:all",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "clean": "rimraf dist api/dist",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "lint": "eslint --format stylish --cache --ext .ts --ext .tsx ./api/src ./e2e ./config ./*.ts",
    "fmt": "prettier --write .",
    "prepare": "husky",
    "start": "tsx ./e2e/tests/index.ts",
    "dev": "tsx watch ./e2e/tests/index.ts",
    "tooling:summary": "tsx config/tooling-summary.ts",
    "test:loans": "npx ts-node scripts/run-loan-tests.ts",
    "test:loans:only": "vitest run api/src/tests/critical/loan-decision-table.test.ts",
    "test:critical": "vitest run -c vitest.critical.config.ts",
    "test:unit:report": "npx ts-node scripts/run-unit-tests.ts",
    "test:a11y": "playwright test -c e2e/playwright.config.ts --grep @a11y",
    "test:a11y:report": "npx ts-node scripts/run-a11y-tests.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "qa",
    "automation",
    "testing",
    "typescript",
    "ci-cd",
    "playwright"
  ],
  "author": "Tom Cunningham",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "zod": "^4.1.13"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
