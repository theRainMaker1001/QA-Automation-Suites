{
  "name": "automatedtesting",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation suite with TypeScript, linting, formatting, and CI integration.",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "main": "index.js",
  "type": "module",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "build:api": "tsc -p api/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts && tsx api/src/helpers/generate-unit-summary.ts",
    "test:api": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:api",
    "test": "npm run test:all",
    "test:e2e": "playwright test -c e2e/playwright.config.ts --project=chromium --grep-invert \"@negative|@known-defect\"",
    "test:e2e:all": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:matrix": "playwright test -c e2e/playwright.config.ts --project=chromium --project=firefox --project=webkit --grep-invert \"@negative|@known-defect\"",
    "clean": "rimraf dist api/dist",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "validate:tags": "tsx scripts/validate-test-tags.ts",
    "lint": "eslint --format stylish --cache --ext .ts --ext .tsx ./api/src ./e2e ./config ./*.ts",
    "fmt": "prettier --write .",
    "prepare": "husky",
    "start": "tsx ./e2e/tests/index.ts",
    "dev": "tsx watch ./e2e/tests/index.ts",
    "tooling:summary": "tsx config/tooling-summary.ts",
    "test:loans": "tsx scripts/run-loan-tests.ts",
    "test:loans:only": "vitest run --config vitest.critical.config.ts api/src/tests/critical/loan-decision-table.test.ts",
    "test:unit:report": "tsx scripts/run-unit-tests.ts",
    "test:smoke": "vitest run --config vitest.integration.config.ts --testNamePattern @smoke && playwright test -c e2e/playwright.config.ts --grep @smoke --project=chromium",
    "test:critical": "vitest run --config vitest.integration.config.ts --testNamePattern @critical && npm run test:loans && playwright test -c e2e/playwright.config.ts --grep @critical --project=chromium --grep-invert @known-defect",
    "test:regression": "playwright test -c e2e/playwright.config.ts --grep @regression --project=chromium-auth",
    "test:regression:matrix": "playwright test -c e2e/playwright.config.ts --grep @regression --project=chromium --project=firefox --project=webkit",
    "test:a11y": "playwright test -c e2e/playwright.config.ts --grep @a11y --project=chromium",
    "test:heartbeat": "vitest run --config vitest.integration.config.ts --testNamePattern @heartbeat",
    "test:audit": "npm run test:regression && npm run test:a11y",
    "test:e2e:smoke": "playwright test -c e2e/playwright.config.ts --grep @smoke --project=chromium",
    "test:e2e:critical": "playwright test -c e2e/playwright.config.ts --grep @critical --project=chromium --grep-invert @known-defect",
    "test:e2e:regression": "playwright test -c e2e/playwright.config.ts --grep @regression --project=chromium",
    "test:e2e:state": "playwright test -c e2e/playwright.config.ts --grep @state-transition --project=chromium --grep-invert @known-defect",
    "test:e2e:known-defects": "playwright test -c e2e/playwright.config.ts --grep @known-defect --project=chromium",
    "test:e2e:negative": "playwright test -c e2e/playwright.config.ts --grep @negative",
    "verify:e2e:critical": "tsx scripts/verify-critical-e2e-results.ts",
    "report:history": "tsx scripts/preserve-allure-history.ts",
    "report:generate": "npm run report:history && npx allure generate allure-results --clean -o allure-report",
    "report:open": "npx allure open allure-report",
    "report:serve": "npx allure serve allure-results",
    "report:stakeholder": "tsx scripts/generate-stakeholder-dashboard.ts",
    "test:nightly": "tsx scripts/run-nightly.ts",
    "docker:build": "docker build -t qa-nightly:local .",
    "docker:run": "docker compose run --rm nightly",
    "docker:audit": "tsx scripts/docker-audit.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "qa",
    "automation",
    "testing",
    "typescript",
    "ci-cd",
    "playwright"
  ],
  "author": "Tom Cunningham",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "allure-vitest": "^3.0.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "zod": "^4.1.13"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
