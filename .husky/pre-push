#!/usr/bin/env bash
set -euo pipefail

echo "🔎 pre-push: typecheck, lint, api tests"

run_if_script () {
  local script="$1"
  node -e "const p=require('./package.json');process.exit(p.scripts && p.scripts['$script']?0:1)" \
    && npm run -s "$script" \
    || echo "ℹ️  skip $script (not defined)"
}

run_if_script typecheck
run_if_script lint
run_if_script "test:api"

# never source husky.sh (deprecated); just exit with success if we got here
exit 0
EOF