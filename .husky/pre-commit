# Zero Gate: Local Enforcement (Husky + lint-staged)
# Blocks commits with formatting/lint issues to keep Git history clean

# Run ESLint + Prettier on staged files
npx lint-staged

# Block if CRLF line endings found
CR=$(printf '\r')
if git grep -I -n --cached "$CR" -- . >/dev/null; then
  echo "CRLF line endings found in staged files."
  echo "  Run: npx prettier --write ."
  exit 1
fi

# Block disallowed punctuation and inaccurate ownership wording
npm run validate:text --silent -- --cached

# Run unit tests - blocks commit on failure (pure logic, no external deps)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ts$' | head -5)
if [ -n "$STAGED_TS" ]; then
  echo "Running unit tests for staged files..."
  npm run test:unit --silent
fi

echo "Zero Gate passed (format, lint, text hygiene, line endings)."
